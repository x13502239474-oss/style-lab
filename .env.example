# 默认：演示模式，无需任何配置即可完整体验
NEXT_PUBLIC_AI_MODE=demo

# 接入真实视觉模型时，填写下列信息并把 AI_MODE 改为 ai
# 接口需兼容 OpenAI Chat Completions 协议
NEXT_PUBLIC_AI_ENDPOINT=
NEXT_PUBLIC_AI_API_KEY=
NEXT_PUBLIC_AI_MODEL=gpt-4o-mini

# GitHub Pages 部署时填仓库名，例如 /style-lab；本地开发留空
NEXT_PUBLIC_BASE_PATH=

# 注意：NEXT_PUBLIC_* 会在构建时被内联到静态文件。
# 公开仓库请不要在 .env.local 中提交真实密钥，生产环境建议把 endpoint
# 指向自己的服务端代理，由代理保管密钥。
